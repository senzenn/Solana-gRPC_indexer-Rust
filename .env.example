# Solana Indexer environment
# Copy to .env and fill in values. Env vars override index.yaml where noted.

# Yellowstone geyser gRPC endpoint (required)
YELLOWSTONE_ENDPOINT="https://your-geyser-grpc.example.com"

# Provider x-token for geyser auth
YELLOWSTONE_AUTH_TOKEN=""

# Database URL — SQLite file or Postgres DSN (overrides store.url)
DATABASE_URL="sqlite:./index.db"
# DATABASE_URL="postgresql://user:pass@localhost:5432/indexer"

# Solana JSON-RPC for gap backfill and parser fetch/watch (overrides rpc_url)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Optional: comma-separated API keys for protected REST/WS routes (overrides auth.api_keys)
# When empty, protected routes are open (dev mode)
INDEX_API_KEYS=""
