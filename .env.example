# Solana Indexer environment
# Copy to .env and fill in values. Env vars override index.yaml where noted.
# An empty value counts as unset, so it does not override index.yaml.

# Yellowstone geyser gRPC endpoint (required). Triton Dragon's Mouth or Richat.
# Examples:
#   https://<triton-grpc-host>
#   https://<richat-host>:443
#   http://127.0.0.1:10000          # local yellowstone/richat (legacy :10000)
# host:port with no scheme means https:// unless the host is loopback.
# A remote plaintext endpoint needs an explicit http://.
YELLOWSTONE_ENDPOINT=""

# Provider x-token for geyser auth (Triton / Richat / Dragon's Mouth)
YELLOWSTONE_AUTH_TOKEN=""

# Database URL — SQLite file or Postgres DSN (overrides store.url)
DATABASE_URL="sqlite:./index.db"
# DATABASE_URL="postgresql://user:pass@localhost:5432/indexer"
# Other schemes (for example mysql://) are rejected.

# Solana JSON-RPC for gap backfill and parser fetch/watch (overrides rpc_url)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Optional: comma-separated API keys for protected REST/WS/gRPC routes (overrides auth.api_keys)
# When empty, protected routes are open (dev mode). The default bind is 127.0.0.1, and a
# keyless server (any bind) accepts only localhost, *.localhost or an IP literal as Host (403 otherwise).
# A value with no key in it (for example ",") is an error, not "auth off".
# Use only letters, digits and -._~ in keys (the live view sends them as a WebSocket subprotocol).
INDEX_API_KEYS=""
